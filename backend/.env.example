# VegaIntel Threat Intelligence Platform - Environment Configuration
ENVIRONMENT=production
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Database & Cache (In Docker use service hostnames; in local standalone use localhost)
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=vegaintel_db
REDIS_URL=redis://localhost:6379/0

# Security / JWT
JWT_SECRET=change_me_to_a_secure_random_string_in_production
JWT_EXPIRE_HOURS=24

# Scheduler Interval (minutes)
CRON_COLLECTION_INTERVAL_MINUTES=60

# Optional OSINT API Keys (leave empty to use public rate limits)
OTX_API_KEY=
NVD_API_KEY=
ABUSE_CH_AUTH_KEY=
GITHUB_TOKEN=
VIRUSTOTAL_API_KEY=

# Google reCAPTCHA v3 (optional server-side verification)
RECAPTCHA_SECRET_KEY=
